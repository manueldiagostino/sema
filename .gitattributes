# Normalize line endings to LF in the repository
* text=auto

# package-lock.json is generated by npm — prevent CRLF conversion
# that would cause spurious "modified" state on Windows.
package-lock.json -text

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text   # SVG is text/xml
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.pdf binary
