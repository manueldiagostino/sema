# All text files: normalize to LF in repository, auto-detect in working tree
* text=auto eol=lf

# package-lock.json is generated by npm — prevent CRLF conversion
# that would cause spurious "modified" state on Windows.
package-lock.json -text

# Windows-specific files must retain CRLF in working directory
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix-specific files must always be LF
*.sh text eol=lf
scripts/* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.pdf binary
